{
  "name": "su-multi-arm-ui",
  "version": "2.0.0a3",
  "private": true,
  "description": "Read-only web UI for su_multi_arm (static SPA served by the package's HTTP server at /ui)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/manifest.mjs && node scripts/notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "cytoscape": "^3.34.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
