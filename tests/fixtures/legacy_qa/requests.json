[
  {"name": "ui answer with model selector", "method": "POST", "path": "/api/qa",
   "headers": {"X-QA-Channel": "ui", "X-QA-Source": "ui", "X-Forwarded-For": "192.0.2.10", "User-Agent": "synthetic-browser/1.0"},
   "body": {"question": "Which billing records mention invoices?", "dataset": "demo", "model": "fake-model"},
   "expect_status": 200, "expect_keys": ["question", "answer", "citations", "plan", "timings", "dataset", "answer_model", "compat"]},
  {"name": "ui agentic answer", "method": "POST", "path": "/api/qa",
   "headers": {"X-QA-Channel": "ui"},
   "body": {"question": "Summarise rounding issues", "agentic": true, "dataset": "demo"},
   "expect_status": 200, "expect_keys": ["agentic", "mode"]},
  {"name": "gateway answer with record context and session", "method": "POST", "path": "/api/qa",
   "headers": {"Content-Type": "application/json", "X-QA-Channel": "mcp", "X-QA-Client-Id": "synthetic-client", "X-QA-Session": "conv-0001"},
   "body": {"question": "What is known about region totals?", "dataset": "demo", "mode": "hybrid",
            "record_context": {"recordType": "Case", "recordId": "r05", "subject": "Region totals wrong", "status": "Open"}},
   "expect_status": 200, "expect_keys": ["session_cache", "contextUsed", "delivered_evidence", "answer_model", "timings"]},
  {"name": "gateway search fallback through answer", "method": "POST", "path": "/api/qa",
   "headers": {"X-QA-Channel": "mcp", "X-QA-Client-Id": "synthetic-client"},
   "body": {"question": "invoice rounding", "dataset": "demo"},
   "expect_status": 200},
  {"name": "ui stream", "method": "POST", "path": "/api/qa/stream",
   "headers": {"Accept": "text/event-stream", "X-QA-Channel": "ui"},
   "body": {"question": "Which billing records mention invoices?", "model": "fake-model", "fallback_policy": "error", "dataset": "demo"},
   "expect_status": 200},
  {"name": "typed search with filters", "method": "POST", "path": "/api/search",
   "headers": {"X-QA-Channel": "mcp", "X-QA-Client-Id": "synthetic-client"},
   "body": {"searchString": "billing totals", "page": 1, "pageSize": 5, "maxChars": 4000, "sortBy": "relevance",
            "aggregations": [{"type": "project", "filter": ["Alpha", "Beta"]}], "enrich": false, "dataset": "demo"},
   "expect_status": 200, "expect_keys": ["budget", "compat", "notice", "guidance"]},
  {"name": "filter options", "method": "POST", "path": "/api/search",
   "body": {"searchString": "billing", "page": 1, "pageSize": 1, "facetsOnly": true, "dataset": "demo"},
   "expect_status": 200, "expect_keys": ["aggregations", "totalResults"]},
  {"name": "empty question", "method": "POST", "path": "/api/qa", "body": {"question": ""}, "expect_status": 422, "expect_keys": ["detail"]},
  {"name": "missing question", "method": "POST", "path": "/api/qa", "body": {}, "expect_status": 422, "expect_keys": ["detail"]},
  {"name": "unknown dataset never defaults", "method": "POST", "path": "/api/qa", "body": {"question": "billing", "dataset": "elsewhere"}, "expect_status": 422},
  {"name": "retired dataset", "method": "POST", "path": "/api/qa/stream", "body": {"question": "billing", "dataset": "old_kb"}, "expect_status": 422},
  {"name": "datasets", "method": "GET", "path": "/api/datasets", "expect_status": 200, "expect_keys": ["datasets", "default"]},
  {"name": "models", "method": "GET", "path": "/api/models", "expect_status": 200, "expect_keys": ["models", "default"]},
  {"name": "clusters", "method": "GET", "path": "/api/clusters", "expect_status": 200, "expect_keys": ["clusters"]},
  {"name": "evolution", "method": "GET", "path": "/api/evolution", "expect_status": 200, "expect_keys": ["epochs", "status"]},
  {"name": "replay runs", "method": "GET", "path": "/api/replay-runs", "expect_status": 200, "expect_keys": ["runs"]},
  {"name": "health", "method": "GET", "path": "/health", "expect_status": 200, "expect_keys": ["ok", "build_id"]},
  {"name": "source page", "method": "GET", "path": "/source", "params": {"dataset": "demo", "id": "r02"}, "expect_status": 200,
   "expect_keys": ["id", "kind", "title", "title_derived", "external_url", "sections", "metadata"]},
  {"name": "source of unknown id", "method": "GET", "path": "/source", "params": {"dataset": "demo", "id": "r404"}, "expect_status": 404}
]
